rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Learner profiles hold a minor's evidence-based learning data.
    // (T02 — fixes a public-read hole: this collection used to allow
    // `read: if true` for everyone. All learner reads/writes now go
    // through the server's Admin SDK, which bypasses these rules and
    // enforces ownership itself — see server/middleware/requireAuth.ts.)
    match /learners/{learnerId} {
      allow read, write: if false;
    }
    match /learners/{learnerId}/events/{eventId} {
      allow read, write: if false;
    }
    match /learners/{learnerId}/plans/{planId} {
      allow read, write: if false;
    }
    match /learners/{learnerId}/sessions/{sessionId} {
      allow read, write: if false;
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /sessions/{sessionId} {
      allow read: if isSignedIn()
        && resource.data.ownerUid == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if isSignedIn()
        && resource.data.ownerUid == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
