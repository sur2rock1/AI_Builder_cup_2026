rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function canSeeLearner(learnerId) {
      let d = get(/databases/$(database)/documents/learners/$(learnerId)).data;
      return isSignedIn()
        && d != null
        && (d.ownerUid == request.auth.uid || d.parentUid == request.auth.uid);
    }

    match /learners/{learnerId} {
      allow read: if isSignedIn() && (
        resource.data.ownerUid == request.auth.uid ||
        resource.data.parentUid == request.auth.uid
      );
      allow create: if isSignedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.keys().hasAll(['studentId', 'name', 'grade']);
      allow update: if isSignedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if false;

      match /materials/{materialId} {
        allow read: if canSeeLearner(learnerId);
        allow write: if false;
      }
      match /programs/{programId} {
        allow read: if canSeeLearner(learnerId);
        allow write: if false;
      }
      match /enrollments/{curriculumId} {
        allow read: if canSeeLearner(learnerId);
        allow write: if false;
      }
    }

    match /curricula/{curriculumId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /sessions/{sessionId} {
      allow read: if canSeeLearner(resource.data.learnerId);
      allow write: if false;

      match /turns/{turnId} {
        allow read: if canSeeLearner(
          get(/databases/$(database)/documents/sessions/$(sessionId)).data.learnerId
        );
        allow write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
