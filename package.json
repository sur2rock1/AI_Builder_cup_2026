{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npx --yes tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "npx --yes tsc --noEmit",
    "gen:assets": "node scripts/generate-assets.mjs",
    "test:assessor": "node tests/run.mjs",
    "test:live": "node tests/live/run.mjs",
    "test": "node tests/run.mjs && node tests/live/run.mjs",
    "diagnose:voice": "npx --yes tsx scripts/diagnose-voice.ts",
    "firebase:deploy": "npm run build:web && npx -y firebase-tools@latest deploy --project sceneflow-f9529",
    "firebase:deploy:rules": "npx -y firebase-tools@latest deploy --only firestore:rules,storage,auth --project sceneflow-f9529",
    "firebase:deploy:functions": "npx -y firebase-tools@latest deploy --only functions --project sceneflow-f9529",
    "build:web": "vite build"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^11.10.0",
    "firebase-admin": "^13.10.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.4.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "three": "^0.186.0",
    "vite": "^6.2.3",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.13",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "allowScripts": {
    "protobufjs@7.6.6": true,
    "@google/genai@2.23.0": true
  }
}
