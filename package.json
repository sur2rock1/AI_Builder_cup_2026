{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npx --yes tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "npx --yes tsc --noEmit",
    "check:docs": "node scripts/check-docs-sync.mjs",
    "gen:assets": "node scripts/generate-assets.mjs",
    "test:assessor": "node tests/run.mjs",
    "test:live": "node tests/live/run.mjs",
    "test:tutor-turn": "npx --yes tsx tests/smoke/tutor-turn.mjs",
    "test:tutor-turn-offline": "node tests/smoke/tutor-turn-offline.mjs",
    "test:plan-delta-outcome": "node tests/smoke/plan-delta-outcome.mjs",
    "test": "node tests/run.mjs && node tests/live/run.mjs && node tests/smoke/plan-delta-outcome.mjs",
    "pregen:first": "npx --yes tsx scripts/pregenerate-assets.ts --first-only",
    "pregen": "npx --yes tsx scripts/pregenerate-assets.ts",
    "diagnose:voice": "npx --yes tsx scripts/diagnose-voice.ts",
    "firebase:deploy": "npm run build:web && npx -y firebase-tools@latest deploy",
    "firebase:deploy:rules": "npx -y firebase-tools@latest deploy --only firestore:rules,storage,auth",
    "build:web": "vite build",
    "deploy:live": "bash scripts/deploy-cloudrun.sh",
    "deploy:hosting": "npm run build:web && npx -y firebase-tools@latest deploy --only hosting",
    "verify:models": "npx --yes tsx scripts/verify-models.ts",
    "seed:demo": "npx --yes tsx scripts/seed-demo-learners.ts",
    "test:curriculum": "npx --yes tsx tests/smoke/curriculum-ingest.mjs",
    "migrate:cloud": "npx --yes tsx scripts/migrate-local-to-cloud.ts",
    "verify:migration": "npx --yes tsx scripts/verify-migration.ts",
    "preview:visuals": "npx --yes tsx scripts/preview-visuals.tsx",
    "test:visuals": "npx --yes tsx tests/smoke/board-visual.mjs",
    "pregen:ch1": "npx --yes tsx scripts/pregenerate-assets.ts --chapter \"^Chapter 1:\" --force --resume --max-calls 120 --max-images 15",
    "prune:photos": "npx --yes tsx scripts/prune-stale-photos.ts",
    "backfill:apply": "npx --yes tsx scripts/backfill-from-log.ts",
    "backfill:design": "npx --yes tsx scripts/backfill-design.ts",
    "spec:ch1": "npx --yes tsx scripts/content-spec.ts",
    "pregen:ch1:plan": "npx --yes tsx scripts/pregenerate-assets.ts --chapter \"^Chapter 1:\" --force --dry-run",
    "pregen:ch1:redo": "npx --yes tsx scripts/pregenerate-assets.ts --chapter \"^Chapter 1:\" --force --max-calls 120 --max-images 15",
    "test:tutor-name": "node tests/tutor-name/run.mjs",
    "guided:first-chapter": "npx --yes tsx scripts/generate-guided.ts --preset first-chapter",
    "guided:first-chapter:plan": "npx --yes tsx scripts/generate-guided.ts --preset first-chapter --dry-run",
    "upgrade:pregen": "npx --yes tsx scripts/upgrade-pregen.ts",
    "review:pregen": "npx --yes tsx scripts/review-pregen.ts",
    "test:quality": "npx --yes tsx tests/smoke/quality.mjs && npx --yes tsx tests/smoke/lesson-gen.mjs && npx --yes tsx tests/smoke/photo-gen.mjs && npx --yes tsx tests/smoke/quiz-evidence.mjs && npx --yes tsx tests/smoke/ladder-pair.mjs && npx --yes tsx tests/smoke/serve.mjs && npx --yes tsx tests/smoke/content-spec.mjs",
    "test:gates": "npm run -s test:quality && npm run -s test:visuals && npm run -s test:curriculum",
    "verify": "npm run -s lint && npm run -s test:gates && npm run -s review:pregen"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^11.10.0",
    "firebase-admin": "^13.10.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.4.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "three": "^0.186.0",
    "vite": "^6.2.3",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.13",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "allowScripts": {
    "protobufjs@7.6.6": true,
    "@google/genai@2.23.0": true
  }
}
