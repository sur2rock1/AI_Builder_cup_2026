# GEMINI_API_KEY: Required for Gemini AI API calls (local + Cloud Functions secret).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Firebase / GCP project
GOOGLE_CLOUD_PROJECT=sceneflow-f9529
GOOGLE_CLOUD_LOCATION=us-central1
FIREBASE_STORAGE_BUCKET=sceneflow-f9529.firebasestorage.app

# Local Admin SDK credentials (gitignored). On Cloud Functions this is not needed.
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccount.json
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccount.json

# Optional: use Vertex / enterprise Gemini path
# GOOGLE_GENAI_USE_ENTERPRISE=true

# Live voice model (Gemini Developer API). Requires AI Studio credits.
LIVE_MODEL=gemini-3.8-live
# Keep Vertex enterprise off for Live with AQ.*/AI Studio keys, or Live closes immediately.
# GOOGLE_GENAI_USE_ENTERPRISE=false

# Optional: override Live WebSocket origin (defaults to Cloud Run on *.web.app)
# VITE_LIVE_WS_BASE=https://dr-marcus-live-45388528859.us-central1.run.app

# Content library (docs/CURRICULUM.md §5). Required to upload/delete textbooks from anywhere
# other than the server's own machine. Send it as the X-Admin-Token header (the admin screen asks for it).
ADMIN_TOKEN=change-me-to-a-long-random-string
# Set to true to skip background lesson pre-generation after a course is published.
# DISABLE_PREGEN=false
# Server default for "Chapters to load" when an upload doesn't specify it (number or "all"). The admin form sends 3 unless changed.
# DEFAULT_CHAPTER_LIMIT=3

# Optional: override the image-generation model used for the pre-generated "real-world
# photo" (scripts/pregenerate-assets.ts) and, if set, src/ai/gateway.ts's `image` role.
# Default is gemini-3.1-flash-image, falling back to gemini-3.1-flash-lite-image.
# MODEL_IMAGE=gemini-3.1-flash-image

# Pre-generated lesson/diagram/photo cache (src/curriculum/pregenStore.ts). Uses the same
# Firebase Admin credentials as everything else above (FIREBASE_SERVICE_ACCOUNT_PATH /
# GOOGLE_APPLICATION_CREDENTIALS + FIREBASE_STORAGE_BUCKET) — nothing extra to set once
# those are configured. Without them it falls back to data/pregenerated/*.json, which is
# fine locally but does NOT survive a Cloud Run redeploy/cold start, so every concept
# regenerates (and re-bills) on the next instance. Set these before deploying.
# PREGEN_DATA_DIR=./data/pregenerated   # local-fallback path override, mainly for tests
